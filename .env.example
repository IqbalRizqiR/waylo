# ==============================================================================
# WAYLO MONOREPO - SINGLE ENVIRONMENT CONFIGURATION (DOCKER COMPOSE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC DOMAINS (Routed by Webuzo Reverse Proxy)
# ------------------------------------------------------------------------------
# For Local Dev: http://localhost:3000, http://localhost:4000, http://localhost:3001
# For VPS / Webuzo: https://app.yourdomain.com, https://api.yourdomain.com, https://monitoring.yourdomain.com
FRONTEND_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:4000
MONITORING_DOMAIN=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. LOCAL BINDING PORTS (Loopback 127.0.0.1 for Webuzo Reverse Proxy)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=4000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
POSTGRES_PORT=5433
REDIS_PORT=6380

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=waylo
POSTGRES_PASSWORD=waylo
POSTGRES_DB=waylo

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUE (Redis 7)
# ------------------------------------------------------------------------------
REDIS_MAX_MEMORY=256mb

# ------------------------------------------------------------------------------
# 5. BACKEND API AUTH & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Payment Gateway (Midtrans - Optional / Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-waylo-demo
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 6. GRAFANA WAR ROOM
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
