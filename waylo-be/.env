# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml, host port 5433)
DATABASE_URL="postgresql://waylo:waylo@localhost:5433/waylo?schema=public"

# Auth: replace with strong random values outside local development
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"